# ============================================================
# ThreadScope — contoh konfigurasi
# Salin file ini menjadi .env lalu isi:  cp .env.example .env
# JANGAN pernah commit .env (sudah masuk .gitignore)
# ============================================================

# --- Session cookie Threads ---
# Ambil dari browser: F12 > Application > Cookies > threads.com
THREADS_SESSION_ID=
THREADS_CSRF_TOKEN=
THREADS_DS_USER_ID=
THREADS_MID=
THREADS_IG_DID=

# --- Mode bot ---
# normal = balas postingan acak di timeline
# trend  = prioritaskan postingan ramai (30+ likes, 3+ replies)
APP_MODE=normal

# --- Backend LLM: Qoder CLI ---
# Tidak perlu API key. Cukup pastikan `qoder` sudah terinstall dan login.
# QODER_BIN=/path/ke/qoder   # isi hanya jika `qoder` tidak ada di PATH
# QODER_MODEL=               # kosongkan untuk pakai model default akunmu
# QODER_TIMEOUT=180          # detik, batas tunggu satu balasan
# QODER_MAX_TOKENS=350       # panjang maksimal balasan

# --- Lainnya ---
# REPLY_CACHE_FILE=reply_cache.json
